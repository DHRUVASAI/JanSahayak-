import os
import time
import uuid
from typing import Dict, Any

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC


def submit_pm_kisan_application(data: Dict[str, Any]) -> Dict[str, Any]:
    options = Options()
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")

    driver = webdriver.Chrome(options=options)

    try:
        # Open mock portal
        portal_url = os.getenv(
            "MOCK_PORTAL_URL",
            "http://localhost:3000/mock_portal/pm_kisan.html",
        )
        driver.get(portal_url)
        wait = WebDriverWait(driver, 10)

        # Fill each field
        fields = {
            "applicant_name": data.get("name", ""),
            "aadhaar_number": data.get("aadhaar", ""),
            "mobile_number": data.get("mobile", ""),
            "dob": data.get("dob", ""),
            "bank_account": data.get("bank_account", ""),
            "ifsc_code": data.get("ifsc", ""),
            "land_area": data.get("land_area", ""),
            "state": data.get("state", ""),
            "district": data.get("district", ""),
        }

        for field_id, value in fields.items():
            try:
                element = wait.until(
                    EC.presence_of_element_located((By.ID, field_id))
                )
                element.clear()
                element.send_keys(str(value))
                time.sleep(0.3)
            except Exception as e:
                print(f"[RPA] Field {field_id} not found: {e}")

        # Click submit button
        submit_btn = wait.until(
            EC.element_to_be_clickable((By.ID, "submit_btn"))
        )
        submit_btn.click()
        time.sleep(2)

        # Get application ID from success page
        try:
            app_id_element = driver.find_element(By.ID, "application_id")
            app_id = app_id_element.text
        except Exception:
            app_id = "JS" + uuid.uuid4().hex[:8].upper()

        return {"success": True, "application_id": app_id}

    except Exception as e:
        print(f"[RPA ERROR] {e}")
        return {
            "success": False,
            "application_id": "JS" + uuid.uuid4().hex[:8].upper(),
        }
    finally:
        driver.quit()


def submit_ration_card_application(data: Dict[str, Any]) -> Dict[str, Any]:
    options = Options()
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")

    driver = webdriver.Chrome(options=options)

    try:
        portal_url = os.getenv(
            "RATION_CARD_PORTAL_URL",
            "http://localhost:3000/mock_portal/ration_card.html",
        )
        driver.get(portal_url)
        wait = WebDriverWait(driver, 10)

        fields = {
            "full_name": data.get("name", ""),
            "address": data.get("address", ""),
            "income": data.get("income", ""),
            "family_members": data.get("family_members", ""),
            "mobile": data.get("mobile", ""),
            "state": data.get("state", ""),
            "district": data.get("district", ""),
            "pincode": data.get("pincode", ""),
        }

        for field_id, value in fields.items():
            if not value:
                continue
            try:
                element = wait.until(
                    EC.presence_of_element_located((By.ID, field_id))
                )
                element.clear()
                element.send_keys(str(value))
                time.sleep(0.3)
            except Exception as e:
                print(f"[RPA] Field {field_id} not found: {e}")

        submit_btn = wait.until(
            EC.element_to_be_clickable((By.ID, "submit_btn"))
        )
        submit_btn.click()
        time.sleep(2)

        try:
            app_id_element = driver.find_element(By.ID, "application_id")
            app_id = app_id_element.text
        except Exception:
            app_id = "RC" + uuid.uuid4().hex[:8].upper()

        return {"success": True, "application_id": app_id}

    except Exception as e:
        print(f"[RPA ERROR] {e}")
        return {
            "success": False,
            "application_id": "RC" + uuid.uuid4().hex[:8].upper(),
        }
    finally:
        driver.quit()


