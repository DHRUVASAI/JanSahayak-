# ─────────────────────────────────────────────────────────────────────────────
# JanSahayak — Environment Variables Example
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Bot Tokens ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
GROQ_API_KEY_2=

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CRED=firebase-credentials.json

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider Selection
# AI_PROVIDER controls which cloud provider handles LLM, OCR, STT, and storage.
# "aws"  → Amazon Bedrock / Textract / Transcribe / S3 / DynamoDB (default)
# "ibm"  → watsonx.ai Granite / Watson STT / IBM COS / Cloudant
#           On any IBM failure, automatically falls back to AWS.
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=aws

# ── Database Shadow Write (for migration validation) ─────────────────────────
# DB_SHADOW_WRITE=true  → every write goes to BOTH DynamoDB AND Cloudant
# DB_READ_SOURCE        → which DB serves reads: "aws" or "ibm"
DB_SHADOW_WRITE=false
DB_READ_SOURCE=aws

# ─────────────────────────────────────────────────────────────────────────────
# AWS Services (used when AI_PROVIDER=aws, and always as fallback)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# IBM watsonx.ai  (ibm-watsonx-ai package — foundation model inference)
# Used for: Granite LLM calls, Granite Vision OCR
# ─────────────────────────────────────────────────────────────────────────────
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://eu-gb.ml.cloud.ibm.com

# Text model — confirmed available: ibm/granite-3-3-8b-instruct
IBM_LLM_MODEL_ID=ibm/granite-3-3-8b-instruct

# Vision/OCR model — ⚠️ VERIFY against your account before deploying
# Run: api_client.foundation_models.ChatModels.show() to list available models
# Known candidates: ibm/granite-vision-3-2-2b, ibm/granite-vision-4-1-4b
# Falls back to local Tesseract on ModelNotFound automatically.
IBM_VISION_MODEL_ID=ibm/granite-vision-3-2-2b

# ─────────────────────────────────────────────────────────────────────────────
# IBM Watson Speech to Text  (ibm-watson package — classic Watson services)
# Used for: voice message transcription
# ─────────────────────────────────────────────────────────────────────────────
IBM_SPEECH_TO_TEXT_APIKEY=
IBM_SPEECH_TO_TEXT_URL=

# ─────────────────────────────────────────────────────────────────────────────
# IBM Cloud Object Storage  (boto3 S3-compatible API)
# Used for: screenshot and Aadhaar image storage
# ─────────────────────────────────────────────────────────────────────────────
IBM_COS_APIKEY=
IBM_COS_INSTANCE_ID=
IBM_COS_ENDPOINT=
IBM_COS_BUCKET=jansahayak-ibm

# ─────────────────────────────────────────────────────────────────────────────
# IBM Cloudant  (NoSQL document store — replaces DynamoDB when AI_PROVIDER=ibm)
# Used for: user profiles and application records
# ─────────────────────────────────────────────────────────────────────────────
IBM_CLOUDANT_URL=
IBM_CLOUDANT_APIKEY=

# ─────────────────────────────────────────────────────────────────────────────
# SNS / SMS — AWS ONLY, intentionally NOT abstracted
# IBM Cloud has no direct equivalent for transactional A2P SMS.
# sns_send_sms() always calls aws_services directly regardless of AI_PROVIDER.
# ─────────────────────────────────────────────────────────────────────────────
# (no IBM SMS env vars — by design)
